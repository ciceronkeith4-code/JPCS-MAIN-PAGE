rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requester is an admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      // Own profile OR admin
      allow write: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
    }

    // Semesters — students may read/write their own; admins can do anything
    match /semesters/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (resource == null || resource.data.user_id == request.auth.uid || isAdmin());
    }

    // Subjects — scoped via semester ownership; admins unrestricted
    match /subjects/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Curriculum — read by any authenticated user; write by admins only
    match /curriculum/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Announcements — read by any authenticated user; write by admins only
    match /announcements/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Award settings — read by any authenticated user; write by admins only
    match /award_settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
